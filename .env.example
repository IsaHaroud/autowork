# Telegram - get from @BotFather
BOT_TOKEN=123456789:AAH_YOUR_BOT_TOKEN_HERE
# also accepts: TELEGRAM_BOT_TOKEN, bot_token (backward compat)

# Admin - your personal Telegram ID (get it via /start, then set here)
ADMIN_TELEGRAM_ID=5985506836

# Owner contact shown to users on /start
OWNER_WHATSAPP_NUMBER=+212639989745
# also accepts: OWNER_WHATSAPP, WHATSAPP_NUMBER

# WhatsApp Cloud API (for later - leave empty for now)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=autowork_verify_123

# Admin dashboard PASSWORD (required on VPS!)
# This IS the password for https://yourdomain.com/admin
# Example: ADMIN_TOKEN=Aw-2026-xyz789-long-secret
# After setting: restart server, open /admin, enter this password once (saved in browser).
ADMIN_TOKEN=change-me-to-a-long-secret

# Optional
TELEGRAM_BOT_USERNAME=autowork0_bot
DATABASE_PATH=./data/autowork.db
PORT=3000
